{
  "expo": {
    "name": "Pillgrim",
    "slug": "medication-reminder",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#AED581"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ambar40.pillgrim"
    },
    "android": {
      "newArchEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ambar40.pillgrim",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class expo.modules.notifications.** { *; }\n-keep class * extends android.content.BroadcastReceiver { *; }\n-keep class * extends android.app.Service { *; }"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#AED581",
          "sounds": [
            "./assets/sounds/apoc_sound.wav",
            "./assets/sounds/dozer_sound.wav",
            "./assets/sounds/mouse_sound.wav",
            "./assets/sounds/switch_sound.wav",
            "./assets/sounds/tank_sound.wav"
          ]
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-audio",
      "expo-asset",
      "react-native-permissions"
    ],
    "extra": {
      "eas": {
        "projectId": "ae3019d5-50da-46fa-9941-5085d4fb1b3d"
      }
    }
  }
}
